{
  "name": "march-mad",
  "version": "1.0.0",
  "description": "",
  "main": "electron-main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:start": "npm run build && electron .",
    "electron:package": "npm run build && electron-builder --win --x64",
    "icons": "node scripts/make-icon.js"
  },
  "build": {
    "appId": "com.stephencj.marchmad",
    "productName": "March Mad",
    "files": [
      "electron-main.js",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.0",
    "png-to-ico": "^3.0.1",
    "puppeteer": "^24.41.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
}
